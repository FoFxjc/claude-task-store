{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/FoFxjc/claude-task-store/schemas/state.schema.json",
  "title": "ClaudeTaskState",
  "description": "Persistent multi-topic execution state for claude-task-store. Only active_topic is projected into resume context.",
  "type": "object",
  "required": ["version", "active_topic", "topics", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "description": "Schema version for migration support", "enum": ["2"] },
    "revision": { "type": "integer", "description": "Monotonically increasing write counter.", "minimum": 0 },
    "active_topic": { "type": "string", "description": "Topic used by task commands and resume injection.", "minLength": 1, "maxLength": 100 },
    "topics": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Topic" } },
    "updated_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": ["string", "null"], "description": "Optional last writer. Never affects execution semantics.", "maxLength": 100 }
  },
  "definitions": {
    "Topic": {
      "type": "object",
      "required": ["name", "goal", "status", "current_task", "tasks", "next_action", "created_at", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Unique human-readable topic name.", "minLength": 1, "maxLength": 100 },
        "goal": { "type": "string", "description": "One-sentence topic goal.", "minLength": 1, "maxLength": 300 },
        "status": { "type": "string", "enum": ["active", "blocked", "completed", "archived"], "description": "Topic status, independent of whether it is selected." },
        "current_task": { "type": ["string", "null"], "description": "Current topic-local task ID." },
        "tasks": { "type": "array", "items": { "$ref": "#/definitions/Task" } },
        "decisions": { "type": "array", "items": { "$ref": "#/definitions/Decision" } },
        "blockers": { "type": "array", "items": { "$ref": "#/definitions/Blocker" } },
        "next_action": { "type": ["string", "null"], "description": "Next action for this topic.", "maxLength": 500 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "Task": {
      "type": "object",
      "required": ["id", "title", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^T[0-9]+$", "description": "Topic-local task identifier, e.g. T1." },
        "title": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending", "in_progress", "blocked", "done", "skipped"] },
        "notes": { "type": ["string", "null"], "maxLength": 1000 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "attempts": { "type": "array", "items": { "$ref": "#/definitions/Attempt" } },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "Attempt": {
      "type": "object",
      "required": ["description", "outcome"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "maxLength": 300 },
        "outcome": { "type": "string", "maxLength": 300 },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "Decision": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "maxLength": 300 },
        "rationale": { "type": ["string", "null"], "maxLength": 500 },
        "at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "Blocker": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "maxLength": 300 },
        "task_id": { "type": ["string", "null"] },
        "since": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
